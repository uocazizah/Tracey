name: GCC X86_64 Windows

on:
  pull_request:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - uses: actions/checkout@v7

      - name: Setup MSYS2
        uses: msys2/setup-msys2@v2
        with:
          update: true
          msystem: UCRT64
          path-type: minimal
          cache: true
          install: >-
            mingw-w64-ucrt-x86_64-gcc
            mingw-w64-ucrt-x86_64-cmake
            mingw-w64-ucrt-x86_64-ninja
            mingw-w64-ucrt-x86_64-pkgconf
            python
            python-pip

      - name: Install Python dependencies
        shell: msys2 {0}
        run: |
          python -m pip install kconfiglib --break-system-packages

      - name: Build
        shell: msys2 {0}
        run: |
          cd bootstrap
          rm -rf build
          mkdir build
          cd build

          cmake .. \
            -G Ninja \
            -DARCH=native \
            -DCMAKE_C_COMPILER=/ucrt64/bin/gcc.exe \
            -DCMAKE_CXX_COMPILER=/ucrt64/bin/g++.exe

          cmake --build . --verbose
