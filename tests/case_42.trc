// case_42.trc: do/while loop
// expect_exit: 55
// The body runs before the condition is tested, so the loop executes at
// least once even when the condition starts false.

int main()
{
    int i = 0;
    int s = 0;

    do
    {
        s = s + i;
        i = i + 1;
    } while (i < 10);

    return s + i;   // 45 + 10 = 55
}
