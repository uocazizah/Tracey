// case_45.trc: switch with no fall-through
// expect_exit: 0
// expect_stdout: 2
// Cases are independent: after a case body runs, control leaves the switch.
// The value 2 is printed once, not twice, because case 1 does not fall
// through into case 2.

int main()
{
    int x = 1;

    switch (x)
    {
        case 1:
            print(2);
            break;
        case 2:
            print(3);
            break;
        default:
            print(4);
            break;
    }
    return 0;
}
