#ifndef TRACEY_BUILD_CONFIG_H
#define TRACEY_BUILD_CONFIG_H

/* CMake-generated build metadata for the Tracey bootstrap compiler.
 *
 * Only values that CMake itself resolves (project version, toolchain checks)
 * live here. Feature toggles come from Kconfig via kconfig_autoconf.h, which
 * is included by <tracey/config.hxx>.
 */

/* Project version, forwarded from project(VERSION ...) in CMakeLists.txt. */
#define TRACEY_VERSION_STRING "@PROJECT_VERSION@"

#endif /* TRACEY_BUILD_CONFIG_H */
