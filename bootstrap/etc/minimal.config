CONFIG_TRACEY_DEBUG_TRACE=n
CONFIG_TRACEY_MAX_SOURCE_SIZE=65536
CONFIG_TRACEY_STACK_SIZE=4096
CONFIG_TRACEY_DEFAULT_TARGET_NATIVE=y
CONFIG_TRACEY_USE_ZLIB=n
CONFIG_TRACEY_USE_THREADS=y
CONFIG_TRACEY_MODULE_PARSER=y
CONFIG_TRACEY_MODULE_SEMANTIC=y
CONFIG_TRACEY_MODULE_CODEGEN=y
CONFIG_TRACEY_MODULE_ASSEMBLER=n
CONFIG_TRACEY_MODULE_LINKER=n
