
#
# Build options
#
# CONFIG_TRACEY_DEBUG_TRACE is not set
CONFIG_TRACEY_MAX_SOURCE_SIZE=65536
CONFIG_TRACEY_STACK_SIZE=4096
CONFIG_TRACEY_MAX_LEXER_ERRORS=10
CONFIG_TRACEY_DEFAULT_TARGET_NATIVE=y
# CONFIG_TRACEY_DEFAULT_TARGET_I686 is not set
# CONFIG_TRACEY_DEFAULT_TARGET_X86_64 is not set
# end of Build options

#
# Optional features
#
# CONFIG_TRACEY_USE_ZLIB is not set
CONFIG_TRACEY_USE_THREADS=y
# end of Optional features

#
# Compiler modules
#
CONFIG_TRACEY_MODULE_PARSER=y
CONFIG_TRACEY_MODULE_SEMANTIC=y
CONFIG_TRACEY_MODULE_CODEGEN=y
CONFIG_TRACEY_MODULE_ASSEMBLER=y
CONFIG_TRACEY_MODULE_LINKER=y
# end of Compiler modules
