CONFIG_TRACEY_DEBUG_TRACE=y
CONFIG_TRACEY_MAX_SOURCE_SIZE=1048576
CONFIG_TRACEY_STACK_SIZE=65536
CONFIG_TRACEY_DEFAULT_TARGET_NATIVE=y
CONFIG_TRACEY_USE_ZLIB=y
CONFIG_TRACEY_USE_THREADS=y
CONFIG_TRACEY_MODULE_PARSER=y
CONFIG_TRACEY_MODULE_SEMANTIC=y
CONFIG_TRACEY_MODULE_CODEGEN=y
CONFIG_TRACEY_MODULE_ASSEMBLER=y
CONFIG_TRACEY_MODULE_LINKER=y
